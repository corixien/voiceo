{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voiceo",
  "version": "0.1.0",
  "identifier": "dev.voiceo.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": { "csp": null },
    "windows": [
      {
        "label": "main",
        "title": "Voiceo",
        "url": "index.html",
        "width": 940,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "visible": true
      },
      {
        "label": "overlay",
        "title": "Voiceo Overlay",
        "url": "overlay.html",
        "width": 380,
        "height": 210,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "focusable": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Productivity",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
